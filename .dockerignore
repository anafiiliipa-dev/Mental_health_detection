# Keep the build context small and the image free of anything not needed
# to serve the API. Mirrors .gitignore's intent, but for the Docker build
# context rather than git — the two lists overlap but serve different tools.

.git/
.github/
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
.env

# Not part of the API image — training/notebook/RAG stack, docs, tests.
notebooks/
tests/
docs/
reports/
rag_source/
faiss_index/
models/
data/

# MLflow local store — mounted as a volume at runtime, never baked in.
mlruns/
mlflow.db

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.vscode/
.idea/

*.md
!README.md
